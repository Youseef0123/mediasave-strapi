{
  "kind": "collectionType",
  "collectionName": "job_applications",
  "info": {
    "singularName": "job-application",
    "pluralName": "job-applications",
    "displayName": "Job Application",
    "description": "Job Applications submitted by candidates"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "fullName": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "coverLetter": {
      "type": "text"
    },
    "cv": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["files"]
    },
    "job": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::job.job",
      "inversedBy": "applications"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "New",
        "Reviewed",
        "Shortlisted",
        "Rejected",
        "Hired"
      ],
      "default": "New"
    }
  }
}
